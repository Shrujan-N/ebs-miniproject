// =============================================================================
// VoltEdge Power Systems Pvt. Ltd. — ERPNext v16 MariaDB Entity-Relationship DBML
// 13 Core Tables Modeling ERPNext v16 DocTypes (`tab*` Tables in MariaDB 10.6+)
// =============================================================================

Project VoltEdge_ERPNext_v16 {
  database_type: 'MariaDB'
  Note: 'Authentic ERPNext v16 (Frappe v16, released 12 Jan 2026) MariaDB schema for VoltEdge Power Systems'
}

Table tabEmployee {
  name varchar(140) [pk, note: 'e.g. HR-EMP-0001']
  docstatus int [default: 0]
  employee_name varchar(140) [not null]
  custom_srn varchar(32) [unique, not null, note: 'PES University SRN']
  designation varchar(140) [not null]
  department varchar(140) [not null]
  company_email varchar(140) [unique, not null]
  status varchar(32) [default: 'Active']
}

Table "tabPayment Terms Template" as tabPaymentTermsTemplate {
  name varchar(140) [pk]
  docstatus int [default: 0]
  template_name varchar(140) [not null]
  credit_days int [not null]
  description text
}

Table tabCustomer {
  name varchar(140) [pk]
  docstatus int [default: 0]
  customer_name varchar(140) [not null]
  customer_group varchar(140) [not null]
  territory varchar(140) [not null]
  tax_id varchar(24) [not null, note: 'Indian GSTIN']
  credit_limit decimal(18,2) [default: 0.00]
  payment_terms varchar(140) [ref: > tabPaymentTermsTemplate.name]
  account_manager varchar(140) [ref: > tabEmployee.name]
}

Table tabSupplier {
  name varchar(140) [pk]
  docstatus int [default: 0]
  supplier_name varchar(140) [not null]
  supplier_group varchar(140) [not null]
  country varchar(64) [default: 'India']
  tax_id varchar(24) [not null]
  payment_terms varchar(140) [ref: > tabPaymentTermsTemplate.name]
  custom_buyer_id varchar(140) [ref: > tabEmployee.name]
}

Table tabItem {
  name varchar(140) [pk]
  docstatus int [default: 0]
  item_code varchar(140) [unique, not null]
  item_name varchar(140) [not null]
  item_group varchar(140) [not null, note: 'Finished Goods | Raw Materials']
  stock_uom varchar(32) [default: 'Nos']
  valuation_rate decimal(18,2) [not null]
  standard_rate decimal(18,2) [not null]
  safety_stock int [default: 5]
}

Table tabWarehouse {
  name varchar(140) [pk]
  docstatus int [default: 0]
  warehouse_name varchar(140) [not null]
  warehouse_type varchar(64) [not null]
  city varchar(64) [not null]
  custom_manager_id varchar(140) [ref: > tabEmployee.name]
}

Table "tabSales Order" as tabSalesOrder {
  name varchar(140) [pk, note: 'e.g. SAL-ORD-2026-0001']
  docstatus int [default: 1]
  customer varchar(140) [ref: > tabCustomer.name, not null]
  transaction_date date [not null]
  delivery_date date [not null]
  workflow_state varchar(64) [not null]
  status varchar(64) [not null]
  custom_quotation_id varchar(140)
  custom_delivery_note_id varchar(140)
  custom_sales_invoice_id varchar(140)
  custom_payment_entry_id varchar(140)
  net_total decimal(18,2) [not null]
  total_taxes_and_charges decimal(18,2) [not null]
  grand_total decimal(18,2) [not null]
  owner_employee varchar(140) [ref: > tabEmployee.name, not null]
}

Table "tabSales Order Item" as tabSalesOrderItem {
  name varchar(140) [pk]
  parent varchar(140) [ref: > tabSalesOrder.name, not null]
  parenttype varchar(140) [default: 'Sales Order']
  parentfield varchar(140) [default: 'items']
  idx int [default: 1]
  item_code varchar(140) [ref: > tabItem.name, not null]
  qty decimal(18,3) [not null]
  rate decimal(18,2) [not null]
  amount decimal(18,2) [not null]
}

Table "tabPurchase Order" as tabPurchaseOrder {
  name varchar(140) [pk, note: 'e.g. PUR-ORD-2026-0001']
  docstatus int [default: 1]
  supplier varchar(140) [ref: > tabSupplier.name, not null]
  transaction_date date [not null]
  schedule_date date [not null]
  workflow_state varchar(64) [not null]
  status varchar(64) [not null]
  custom_material_request_id varchar(140)
  custom_purchase_receipt_id varchar(140)
  custom_purchase_invoice_id varchar(140)
  custom_payment_entry_id varchar(140)
  net_total decimal(18,2) [not null]
  total_taxes_and_charges decimal(18,2) [not null]
  grand_total decimal(18,2) [not null]
  custom_buyer_id varchar(140) [ref: > tabEmployee.name, not null]
}

Table "tabPurchase Order Item" as tabPurchaseOrderItem {
  name varchar(140) [pk]
  parent varchar(140) [ref: > tabPurchaseOrder.name, not null]
  parenttype varchar(140) [default: 'Purchase Order']
  parentfield varchar(140) [default: 'items']
  idx int [default: 1]
  item_code varchar(140) [ref: > tabItem.name, not null]
  qty decimal(18,3) [not null]
  rate decimal(18,2) [not null]
  amount decimal(18,2) [not null]
}

Table "tabStock Entry" as tabStockEntry {
  name varchar(140) [pk, note: 'Manufacture / Material Receipt']
  docstatus int [default: 1]
  posting_date date [not null]
  stock_entry_type varchar(64) [not null]
  custom_item_code varchar(140) [ref: > tabItem.name, not null]
  to_warehouse varchar(140) [ref: > tabWarehouse.name, not null]
  fg_completed_qty decimal(18,3) [not null]
  valuation_rate decimal(18,2) [not null]
  remarks text
  owner varchar(140) [ref: > tabEmployee.name, not null]
}

Table "tabStock Ledger Entry" as tabStockLedgerEntry {
  name varchar(140) [pk]
  docstatus int [default: 1]
  item_code varchar(140) [ref: > tabItem.name, not null]
  warehouse varchar(140) [ref: > tabWarehouse.name, not null]
  posting_date date [not null]
  voucher_type varchar(64) [not null]
  voucher_no varchar(140) [not null]
  actual_qty decimal(18,3) [not null]
  qty_after_transaction decimal(18,3) [not null]
  valuation_rate decimal(18,2) [not null]
  stock_value decimal(18,2) [not null]
}

Table tabBin {
  name varchar(140) [pk]
  item_code varchar(140) [ref: > tabItem.name, not null]
  warehouse varchar(140) [ref: > tabWarehouse.name, not null]
  actual_qty decimal(18,3) [not null]
  reserved_qty decimal(18,3) [not null]
  projected_qty decimal(18,3) [not null]
  valuation_rate decimal(18,2) [not null]
  stock_value decimal(18,2) [not null]
}
